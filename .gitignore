# Рабочие кадры проверок. Итоговые скриншоты лежат в .shots/final
# и в историю попадают, промежуточные — нет.
.shots/*.png
# Шрифтовые бинарники из чужого скилла: у проекта свой конвейер (scripts/build-fonts.py)
.claude/skills/ui-styling/canvas-fonts/

# промежуточные json-выгрузки замеров
.shots/*.json
!.shots/lh-*.json
# ⚠️ Серия прогонов PageSpeed: в историю идёт ПЕРВЫЙ прогон, остальные
# остаются на диске. Читать надо всё равно серию, а она целиком лежит
# текстом в .shots/pagespeed.txt; каждый json весит полмегабайта.
.shots/lh-*-[0-9].json
.shots/enter/
.shots/cut/
# подбор пропорции знака и рабочие кадры середины страницы
.shots/mid/
.shots/wmcap/
# рабочие кадры полосы шапки
.shots/nav/
# рабочие кадры двадцать второй итерации
.shots/qa/
